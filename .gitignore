# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# local file uploads (dev/test data; real uploads live in a Docker volume in prod)
/uploads

# Local prod data dumps (PII — never commit)
/prod-users.md

# Mirror of the prod uploads volume, pulled by scripts/sync-prod-to-local.sh
# (real users' photos — never commit)
/uploads-prod

# Playwright MCP scratch output (snapshots, console logs, screenshots).
# Screenshots taken while driving a browser land in the repo root by default,
# so ignore that shape too — a `git add -A` otherwise sweeps a session's worth
# of console screenshots into a commit.
/.playwright-mcp
/*.png

# Android signing material. Losing the upload key is recoverable through Play
# support only because Play App Signing holds the real distribution key —
# committing it is not recoverable at all. Back these up off-machine instead.
/android/keystore
# Bubblewrap's generated Gradle project IS committed, even though `bubblewrap
# update` can recreate it: update re-fetches the live web manifest and quietly
# overwrites fields from it, so having the generated tree in git is what makes
# such a change reviewable rather than invisible. Only the build outputs and
# the toolchain are ignored.
/android/node_modules
/android/build
/android/app/build
/android/.gradle
/android/*.apk
/android/*.aab
/android/*.idsig
/android/*.log
