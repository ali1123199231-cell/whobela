(whobela_common) {
    reverse_proxy whobela-app:3000

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    encode gzip
}

# whobela.com gets a normal eagerly-managed cert (no overlap with the
# *.whobela.com wildcard below, so Caddy provisions it proactively).
whobela.com {
    import whobela_common
}

# www.whobela.com textually matches the *.whobela.com wildcard pattern below,
# so Caddy defers it rather than eagerly provisioning a cert of its own. It is
# covered by the wildcard, and asking for the wildcard by the same DNS-01
# challenge here is what gets it served.
www.whobela.com {
    tls {
        dns cloudflare {env.CLOUDFLARE_API_TOKEN}
    }

    import whobela_common
}

# Per-user pages: {username}.whobela.com, served from a single *.whobela.com
# wildcard certificate obtained over DNS-01.
#
# These were previously issued on demand, one Let's Encrypt certificate per
# user at the moment of first visit. That cost the recipient of an invitation
# 5–7 seconds on the most important pageview in the product — the first time
# they open the link they were sent — and spent one certificate per user
# against the 50-per-week-per-registered-domain ceiling, which growth would
# eventually walk into. One wildcard covers every user, is provisioned before
# anyone asks for it, and is renewed once rather than per subdomain.
#
# Prerequisites: wildcard A record *.whobela.com → server IP, and a Cloudflare
# token in the environment (see ../docker-compose.yml). Custom domains are
# unaffected — they still arrive through the :443 catch-all and are still
# validated on demand by the ask-router.
*.whobela.com {
    tls {
        dns cloudflare {env.CLOUDFLARE_API_TOKEN}
    }

    @isSubdomain not host whobela.com www.whobela.com
    handle @isSubdomain {
        reverse_proxy whobela-app:3000

        header {
            -Server
            X-Content-Type-Options "nosniff"
            Referrer-Policy "strict-origin-when-cross-origin"
        }

        encode gzip
    }
}

# Custom domains for whobela (e.g. a user's own yourname.com, connected via
# Settings) are served through the shared `:443` catch-all in
# conf.d/smartlock.caddy — Caddy allows only one catch-all per port, so that
# one block forwards to the shared ask-router's proxy port (8082), which
# resolves per-request which app actually owns the domain. Validation itself
# happens in /api/public/check-domain (this app) against
# DatePage.customDomain + customDomainVerifiedAt.
