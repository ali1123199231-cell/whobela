// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                         String    @id @default(uuid())
  email                      String    @unique
  passwordHash               String
  username                   String    @unique
  emailNotificationsEnabled  Boolean   @default(true)
  emailVerifiedAt            DateTime?
  verificationCodeHash       String?
  verificationCodeExpiresAt  DateTime?
  verificationCodeSentAt     DateTime?
  verificationCodeAttempts   Int       @default(0)
  resetCodeHash              String?
  resetCodeExpiresAt         DateTime?
  resetCodeSentAt            DateTime?
  resetCodeAttempts          Int       @default(0)
  failedLoginAttempts        Int       @default(0)
  loginLockedUntil           DateTime?
  // Bumped on password change/reset so existing session JWTs (which embed the
  // version at sign-time) stop validating everywhere at once.
  tokenVersion               Int       @default(0)

  // First-touch acquisition attribution, captured client-side at signup.
  signupReferrer     String?
  signupLandingPath  String?
  utmSource          String?
  utmMedium          String?
  utmCampaign        String?
  utmTerm            String?
  utmContent         String?
  gclid              String?

  // ISO 3166-1 alpha-2, derived server-side from Cloudflare's CF-IPCountry
  // header at signup. The request IP itself is never read or stored, and no
  // finer granularity than country is kept. NULL for accounts created before
  // this shipped and for requests where the country was unknown.
  signupCountry      String?   @db.Char(2)

  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  profile            Profile?
  media              Media[]
  datePage           DatePage?
  subscription       Subscription?
  billingClickEvents BillingClickEvent[]
  pushSubscriptions  PushSubscription[]
  deviceTokens       DeviceToken[]

  @@map("users")
}

// A native app install that has agreed to receive notifications.
//
// Deliberately not folded into PushSubscription: FCM hands back one opaque
// registration token with no VAPID keypair, so three of that model's four
// columns would sit empty forever. The two also coexist on one account by
// design — the app on a phone and the site pinned on a laptop are both worth
// notifying, and neither should silently replace the other.
model DeviceToken {
  id       String @id @default(uuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  token    String @unique
  // "android" today. iOS ships nowhere without an Apple Developer account, but
  // storing the platform now means the sender never has to guess later.
  platform String
  // What the install last reported. Makes it possible to tell whether a crash
  // or a delivery failure is confined to one release.
  appVersion String?
  createdAt  DateTime @default(now())
  // Refreshed whenever the app re-registers, so tokens belonging to phones
  // nobody has opened in a year can be pruned without guessing.
  lastSeenAt DateTime @default(now())

  @@index([userId])
  @@map("device_tokens")
}

// A single browser that has agreed to receive notifications. One user can have
// several — phone, laptop, a second browser — and each is independent, so they
// are stored per-endpoint rather than per-user and pruned individually when the
// push service reports one has expired.
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("push_subscriptions")
}

model Profile {
  id                     String   @id @default(uuid())
  userId                 String   @unique
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName              String
  nickname               String?
  age                    Int?
  location               String?
  occupation             String?
  hobbies                String?
  interests              String?
  favoriteActivities     String?
  personalityDescription String?
  instagram              String?
  tiktok                 String?
  facebook               String?
  whatsapp               String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@map("profiles")
}

enum MediaKind {
  PROFILE_PHOTO
  BOOKER_PHOTO
}

model Media {
  id        String    @id @default(uuid())
  userId    String?
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      MediaKind
  path      String
  order     Int       @default(0)
  createdAt DateTime  @default(now())

  responses Response[]

  @@map("media")
}

enum DatePageStatus {
  DRAFT
  PUBLISHED
}

model DatePage {
  id                     String         @id @default(uuid())
  userId                 String         @unique
  user                   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                   String
  status                 DatePageStatus @default(DRAFT)
  theme                  String         @default("romantic-pink")
  inviteConfig           Json           @default("{}")
  yesConfig              Json           @default("{}")
  noConfig               Json           @default("{}")
  reactionConfig         Json           @default("{}")
  schedulingConfig       Json           @default("{}")
  preferenceConfig       Json           @default("{}")
  confirmationConfig     Json           @default("{}")
  publishedAt            DateTime?
  firstPublishedAt       DateTime?
  customDomain           String?        @unique
  customDomainVerifiedAt DateTime?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  responses Response[]
  reports   Report[]

  @@map("date_pages")
}

// Why a report is being made. CHILD_SAFETY is separated from the rest so it can
// be triaged ahead of everything else — Google Play's child safety standards
// require a reporting path that names it explicitly, and it is the one category
// where a delay is not recoverable.
enum ReportReason {
  HARASSMENT
  IMPERSONATION
  SEXUAL_CONTENT
  CHILD_SAFETY
  SPAM
  OTHER
}

enum ReportStatus {
  OPEN
  REVIEWED
  ACTIONED
  DISMISSED
}

// An abuse report about an invitation page.
//
// Filed by whoever is looking at the page — almost always the recipient, who has
// no account and never agreed to anything, so nothing here requires a session
// and every field about the reporter is optional. An anonymous report that says
// only "this is harassment" is still worth having.
model Report {
  id         String       @id @default(uuid())
  // Kept as SetNull rather than Cascade: deleting the offending page must not
  // destroy the evidence that it was reported, or a report becomes a way to
  // find out you should delete your account.
  datePageId String?
  datePage   DatePage?    @relation(fields: [datePageId], references: [id], onDelete: SetNull)
  // Denormalised so the report still says what it was about after the page is
  // gone. Both are captured at report time and never updated.
  pageUsername String?
  pageUrl      String?
  reason     ReportReason
  details    String?
  // Optional, so we can reply. Never required — demanding an email address from
  // someone reporting harassment is a good way to not hear about harassment.
  reporterEmail String?
  status     ReportStatus @default(OPEN)
  createdAt  DateTime     @default(now())

  @@index([status, createdAt])
  @@map("reports")
}

model Response {
  id                    String   @id @default(uuid())
  datePageId            String
  datePage              DatePage @relation(fields: [datePageId], references: [id], onDelete: Cascade)
  recipientName         String
  recipientContact      Json
  recipientMessage      String?
  recipientPhotoMediaId String?
  recipientPhotoMedia   Media?   @relation(fields: [recipientPhotoMediaId], references: [id])
  preferenceSelections  Json?
  chosenDate            String
  chosenTime            String
  timezone              String
  createdAt             DateTime @default(now())

  @@map("responses")
}

enum SubscriptionProvider {
  STRIPE
  PAYPAL
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
}

model Subscription {
  id                     String               @id @default(uuid())
  userId                 String               @unique
  user                   User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider               SubscriptionProvider
  externalSubscriptionId String
  status                 SubscriptionStatus
  currentPeriodEnd       DateTime?
  // Set when the user cancels but has already paid through currentPeriodEnd:
  // status stays ACTIVE (their page keeps serving) and no renewal happens.
  cancelAtPeriodEnd      Boolean              @default(false)
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  @@map("subscriptions")
}

model BillingClickEvent {
  id        String               @id @default(uuid())
  userId    String
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider  SubscriptionProvider
  plan      String
  createdAt DateTime             @default(now())

  @@map("billing_click_events")
}

model SystemConfig {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt

  @@map("system_config")
}
